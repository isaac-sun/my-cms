# 复制为 .env 后按需修改（.env 不提交到 Git）
# 注意：注释单独占一行，不要写在值的后面

# ---- 基础设施（docker compose 使用）----
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms_dev_pw
POSTGRES_DB=cms
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- user-service ----
USER_SVC_ADDR=:8081
USER_GRPC_ADDR=:9091
DATABASE_URL=postgres://cms:cms_dev_pw@localhost:5432/cms?sslmode=disable
REDIS_ADDR=localhost:6379
# 用 openssl rand -base64 48 生成，至少 32 字节
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# ---- bff（W2）----
BFF_PORT=3000
USER_GRPC_TARGET=localhost:9091
WEB_ORIGIN=http://localhost:5173